<script>

/* =====================================================
   SPEED CALCULATOR
===================================================== */

const distanceInput =
    document.getElementById("distanceInput");

const timeInput =
    document.getElementById("timeInput");

const speedReadout =
    document.getElementById("speedReadout");

const tracer =
    document.getElementById("tracer");


function updateSpeed(){

    const d =
        parseFloat(distanceInput.value) || 0;

    const t =
        parseFloat(timeInput.value);

    if(t > 0){

        const speed = d / t;

        speedReadout.textContent =
            speed.toFixed(2);

        const position =
            Math.min(90, Math.max(0, speed * 3));

        tracer.style.left =
            `calc(${position}% - 6px)`;

    }else{

        speedReadout.textContent =
            "—";

        tracer.style.left =
            "6px";

    }

}


distanceInput.addEventListener(
    "input",
    updateSpeed
);

timeInput.addEventListener(
    "input",
    updateSpeed
);


/* =====================================================
   GENERAL QUESTION CHECKING
===================================================== */

document.querySelectorAll(
    ".qcard[data-answer]"
).forEach(card => {

    const button =
        card.querySelector(".check");

    const feedback =
        card.querySelector(".feedback");

    button.addEventListener(
        "click",
        () => {

            const textInput =
                card.querySelector(".ans-text");

            const numberInput =
                card.querySelector(".ans-num");

            const expected =
                card.dataset.answer;

            const tolerance =
                parseFloat(
                    card.dataset.tol || "0"
                );

            let correct = false;

            if(textInput){

                const answer =
                    textInput.value
                    .trim()
                    .toLowerCase()
                    .replace(/\s/g,"");

                correct =
                    answer ===
                    expected
                    .toLowerCase()
                    .replace(/\s/g,"");

            }

            if(numberInput){

                const answer =
                    parseFloat(
                        numberInput.value
                    );

                const target =
                    parseFloat(expected);

                correct =
                    !isNaN(answer) &&
                    Math.abs(
                        answer - target
                    ) <= tolerance;

            }

            feedback.className =
                "feedback show " +
                (correct
                    ? "correct"
                    : "wrong");

            feedback.textContent =
                correct
                    ? "✓ Correct. Well done!"
                    : "✗ Not quite. Try again.";

        }
    );

});


/* =====================================================
   Q7
===================================================== */

document.getElementById(
    "check-q7"
).addEventListener(
    "click",
    () => {

        const a =
            parseFloat(
                document.getElementById("q7a").value
            );

        const b =
            parseFloat(
                document.getElementById("q7b").value
            );

        const c =
            parseFloat(
                document.getElementById("q7c").value
            );

        const d =
            parseFloat(
                document.getElementById("q7d").value
            );

        const correct =
            Math.abs(a - 320) < 2 &&
            Math.abs(b - 16) < .2 &&
            Math.abs(c - 20) < .2 &&
            Math.abs(d - 2.5) < .1;

        const fb =
            document.getElementById("fb-q7");

        fb.className =
            "feedback show " +
            (correct
                ? "correct"
                : "wrong");

        fb.textContent =
            correct
                ? "✓ Correct. Excellent graph analysis!"
                : "✗ Check the area, total time, average speed and gradient.";

    }
);


/* =====================================================
   DISTANCE-TIME SHAPES
===================================================== */

const dtShapes = [

    {
        name:"Uniform speed",
        path:"M30 140 L270 40",
        desc:"A straight sloping line means constant speed. The gradient is constant."
    },

    {
        name:"Stationary",
        path:"M30 90 L270 90",
        desc:"A horizontal line means the distance is not changing. The object is stationary."
    },

    {
        name:"Faster motion",
        path:"M30 140 L270 20",
        desc:"A steeper gradient means a greater speed."
    },

    {
        name:"Slowing down",
        path:"M30 140 Q150 60 270 45",
        desc:"A curve becoming less steep means the object is slowing down."
    }

];


const dtContainer =
    document.getElementById("dt-shapes");

const dtPath =
    document.getElementById("dt-shape-path");

const dtDesc =
    document.getElementById("dt-shape-desc");


dtShapes.forEach(
    (shape,index) => {

        const btn =
            document.createElement("button");

        btn.className =
            "shape-btn";

        btn.textContent =
            shape.name;

        btn.addEventListener(
            "click",
            () => {

                document
                    .querySelectorAll(
                        "#dt-shapes .shape-btn"
                    )
                    .forEach(
                        b =>
                        b.classList.remove(
                            "active"
                        )
                    );

                btn.classList.add(
                    "active"
                );

                dtPath.setAttribute(
                    "d",
                    shape.path
                );

                dtDesc.textContent =
                    shape.desc;

            }
        );

        dtContainer.appendChild(
            btn
        );

        if(index === 0){
            btn.click();
        }

    }
);


/* =====================================================
   VELOCITY-TIME SHAPES
===================================================== */

const vtShapes = [

    {
        name:"Uniform acceleration",
        path:"M30 140 L270 30",
        desc:"A straight positive gradient means constant positive acceleration."
    },

    {
        name:"Constant velocity",
        path:"M30 80 L270 80",
        desc:"A horizontal line means constant velocity and zero acceleration."
    },

    {
        name:"Deceleration",
        path:"M30 30 L270 140",
        desc:"A negative gradient means negative acceleration, or deceleration when the object is moving in the positive direction."
    },

    {
        name:"Stationary",
        path:"M30 140 L270 140",
        desc:"Zero velocity means the object is stationary."
    }

];


