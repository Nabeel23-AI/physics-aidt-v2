<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PhysicsAI 5054 | Motion</title>

<style>
:root{
    --paper:#F7F4EE;
    --paper-2:#EEEAE1;
    --card:#FFFDF9;
    --ink:#252525;
    --ink-soft:#66635D;
    --ink-faint:#8D8981;
    --line:#D8D2C7;

    --flare:#E8541F;
    --flare-ink:#B83E16;

    --brake:#245BD1;
    --brake-ink:#17439B;

    --grav:#137A56;
    --grav-ink:#0B6042;

    --disp:Georgia, "Times New Roman", serif;
    --body:Arial, Helvetica, sans-serif;
    --mono:"Courier New", monospace;

    --radius:14px;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:var(--paper);
    color:var(--ink);
    font-family:var(--body);
    line-height:1.65;
}

header.hero{
    padding:64px 24px 40px;
    max-width:880px;
    margin:0 auto;
    position:relative;
}

.kicker{
    font-family:var(--mono);
    font-size:13px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--flare-ink);
    display:flex;
    align-items:center;
    gap:10px;
}

.kicker::before{
    content:'';
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--flare);
    display:inline-block;
}

h1.title{
    font-family:var(--disp);
    font-weight:700;
    font-size:clamp(48px,9vw,88px);
    margin:8px 0 6px;
    letter-spacing:-0.02em;
    line-height:.95;
}

.subtitle{
    font-family:var(--body);
    font-style:italic;
    color:var(--ink-soft);
    font-size:18px;
    max-width:60ch;
    margin:0 0 28px;
}

.credit{
    font-family:var(--mono);
    font-size:11px;
    color:var(--ink-faint);
}

.wrap{
    max-width:880px;
    margin:0 auto;
    padding:0 24px 100px;
}

section{
    margin:64px 0;
}

.eyebrow{
    font-family:var(--mono);
    font-size:12px;
    color:var(--flare-ink);
    text-transform:uppercase;
    letter-spacing:.08em;
    margin-bottom:6px;
}

section.brake .eyebrow{
    color:var(--brake-ink);
}

section.grav .eyebrow{
    color:var(--grav-ink);
}

h2{
    font-family:var(--disp);
    font-weight:500;
    font-size:32px;
    margin:0 0 14px;
    letter-spacing:-.01em;
}

h3{
    font-family:var(--disp);
    font-size:24px;
    font-weight:500;
    margin:28px 0 10px;
}

p{
    margin:0 0 16px;
    color:var(--ink);
}

p.lead{
    font-size:18px;
    color:var(--ink-soft);
}

.formula{
    font-family:var(--mono);
    background:var(--card);
    border:1px solid var(--line);
    border-left:4px solid var(--flare);
    border-radius:0 8px 8px 0;
    padding:18px 20px;
    margin:20px 0;
    font-size:17px;
}

section.brake .formula{
    border-left-color:var(--brake);
}

section.grav .formula{
    border-left-color:var(--grav);
}

.formula .name{
    display:block;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--ink-faint);
    margin-bottom:6px;
}

.symbols{
    width:100%;
    border-collapse:collapse;
    margin:16px 0;
    font-family:var(--mono);
    font-size:14px;
}

.symbols th,
.symbols td{
    border-bottom:1px solid var(--line);
    padding:8px 10px;
    text-align:left;
}

.symbols th{
    color:var(--ink-faint);
    font-weight:500;
    text-transform:uppercase;
    font-size:11px;
    letter-spacing:.05em;
}

.speedo-box{
    margin-top:32px;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
    padding:24px;
}

.speedo-row{
    display:flex;
    flex-wrap:wrap;
    gap:20px;
    align-items:flex-end;
}

.field{
    display:flex;
    flex-direction:column;
    gap:6px;
    min-width:140px;
}

.field label{
    font-family:var(--mono);
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--ink-faint);
}

.field input{
    font-family:var(--mono);
    font-size:20px;
    padding:8px 10px;
    border:1px solid var(--line);
    border-radius:6px;
    background:var(--paper);
    color:var(--ink);
    width:100%;
}

.readout{
    margin-left:auto;
    text-align:right;
}

.readout .val{
    font-family:var(--mono);
    font-size:36px;
    font-weight:700;
    color:var(--flare-ink);
}

.readout .unit{
    font-family:var(--mono);
    font-size:14px;
    color:var(--ink-faint);
}

.track{
    margin-top:20px;
    height:36px;
    border-radius:18px;
    background:var(--paper-2);
    position:relative;
    overflow:hidden;
    border:1px solid var(--line);
}

.tracer{
    position:absolute;
    top:6px;
    left:6px;
    width:24px;
    height:24px;
    border-radius:50%;
    background:var(--flare);
    transition:left .3s ease;
}

.info-card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:20px 22px;
    margin:20px 0;
}

.info-card strong{
    color:var(--flare-ink);
}

.qcard{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:20px 22px;
    margin:20px 0;
}

.qcard .qlabel{
    font-family:var(--mono);
    font-size:12px;
    color:var(--flare-ink);
    font-weight:700;
    margin-bottom:6px;
}

section.brake .qcard .qlabel{
    color:var(--brake-ink);
}

section.grav .qcard .qlabel{
    color:var(--grav-ink);
}

.qcard .qtext{
    font-size:16px;
    margin-bottom:14px;
}

.qrow{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    align-items:center;
}

.qrow input{
    font-family:var(--mono);
    font-size:15px;
    padding:8px 10px;
    border:1px solid var(--line);
    border-radius:6px;
    background:var(--paper);
    color:var(--ink);
    width:120px;
}

.qrow input.ans-text{
    width:180px;
}

.qrow span.u{
    font-family:var(--mono);
    font-size:13px;
    color:var(--ink-faint);
}

button.check{
    font-family:var(--mono);
    font-size:13px;
    font-weight:700;
    letter-spacing:.03em;
    background:var(--ink);
    color:#fff;
    border:none;
    border-radius:6px;
    padding:9px 16px;
    cursor:pointer;
}

button.check:hover{
    background:var(--flare-ink);
}

.feedback{
    margin-top:12px;
    font-size:14px;
    font-family:var(--mono);
    padding:10px 12px;
    border-radius:6px;
    display:none;
}

.feedback.show{
    display:block;
}

.feedback.correct{
    background:#E4F3EC;
    color:var(--grav-ink);
}

.feedback.wrong{
    background:#FCE9E4;
    color:var(--flare-ink);
}

.uniform-table{
    width:100%;
    border-collapse:collapse;
    margin:16px 0;
}

.uniform-table th,
.uniform-table td{
    border:1px solid var(--line);
    padding:10px;
    text-align:center;
    font-family:var(--mono);
    font-size:14px;
}

.uniform-table th{
    background:var(--paper-2);
    color:var(--ink-soft);
    font-weight:500;
}

.graphwrap{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:20px;
    margin:20px 0;
    overflow-x:auto;
}

svg text{
    font-family:var(--mono);
}

.axis-label{
    font-size:11px;
    fill:var(--ink-faint);
}

.gridline{
    stroke:var(--paper-2);
    stroke-width:1;
}

.axisline{
    stroke:var(--ink-soft);
    stroke-width:1.4;
}

.shape-gallery{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin:14px 0;
}

.shape-btn{
    font-family:var(--mono);
    font-size:12px;
    padding:8px 14px;
    border-radius:20px;
    border:1px solid var(--line);
    background:var(--card);
    cursor:pointer;
    color:var(--ink-soft);
}

.shape-btn.active{
    background:var(--flare);
    border-color:var(--flare);
    color:#fff;
}

.shape-desc{
    font-size:15px;
    color:var(--ink-soft);
    margin-top:6px;
    min-height:44px;
}

.toggle-btn{
    font-family:var(--mono);
    font-size:13px;
    background:transparent;
    border:1px solid var(--line);
    border-radius:6px;
    padding:8px 14px;
    cursor:pointer;
    color:var(--ink-soft);
}

.toggle-btn:hover{
    border-color:var(--ink-soft);
    color:var(--ink);
}

.reveal{
    margin-top:14px;
    padding:14px 16px;
    background:var(--paper-2);
    border-radius:8px;
    font-family:var(--mono);
    font-size:13.5px;
    display:none;
    line-height:1.9;
}

.reveal.show{
    display:block;
}

.reveal b{
    color:var(--ink);
}

.tube-demo{
    display:flex;
    gap:28px;
    flex-wrap:wrap;
    align-items:flex-start;
}

.tube{
    width:64px;
    height:220px;
    border:2px solid var(--ink-soft);
    border-radius:8px;
    position:relative;
    background:var(--card);
    flex:none;
    overflow:hidden;
}

.tube .coin,
.tube .feather{
    position:absolute;
    left:50%;
    transform:translateX(-50%);
    top:12px;
    transition:top 1.2s linear;
}

.tube .coin{
    width:16px;
    height:16px;
    border-radius:50%;
    background:var(--flare);
}

.tube .feather{
    width:20px;
    height:10px;
    border-radius:0 50% 50% 0;
    background:var(--brake);
}

.tube-controls{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.tube-controls .toggle-btn{
    width:fit-content;
}

.tube-note{
    font-size:14px;
    color:var(--ink-soft);
    max-width:42ch;
}

footer{
    max-width:880px;
    margin:0 auto;
    padding:40px 24px 80px;
    font-family:var(--mono);
    font-size:11px;
    color:var(--ink-faint);
    border-top:1px solid var(--line);
}

@media(max-width:600px){

    header.hero{
        padding:44px 18px 24px;
    }

    .wrap{
        padding:0 18px 80px;
    }

    .speedo-row{
        flex-direction:column;
        align-items:stretch;
    }

    .readout{
        margin-left:0;
        text-align:left;
    }

    h2{
        font-size:28px;
    }
}
</style>
</head>

<body>

<header class="hero">

    <div class="kicker">PhysicsAI 5054 · Motion</div>

    <h1 class="title">Motion</h1>

    <p class="subtitle">
        Describing how objects move using distance, speed, velocity,
        acceleration and graphs.
    </p>

    <div class="credit">
        Cambridge O Level Physics · Interactive Learning
    </div>

    <!-- SPEED CALCULATOR -->

    <div class="speedo-box">

        <div class="speedo-row">

            <div class="field">
                <label>Distance / m</label>
                <input type="number" id="distanceInput" value="100" min="0">
            </div>

            <div class="field">
                <label>Time / s</label>
                <input type="number" id="timeInput" value="10" min="0.01">
            </div>

            <div class="readout">
                <div class="val" id="speedReadout">10.00</div>
                <div class="unit">m/s</div>
            </div>

        </div>

        <div class="track">
            <div class="tracer" id="tracer"></div>
        </div>

    </div>

</header>


<main class="wrap">

<!-- ===================================================== -->
<!-- 1. DISTANCE AND DISPLACEMENT -->
<!-- ===================================================== -->

<section>

    <div class="eyebrow">01 · Describing motion</div>

    <h2>Distance and displacement</h2>

    <p class="lead">
        When describing motion, it is important to distinguish between
        the total path travelled and the change in position.
    </p>

    <div class="info-card">
        <p>
            <strong>Distance</strong> is the total length of the path travelled
            by an object. It is a scalar quantity.
        </p>

        <p>
            <strong>Displacement</strong> is the distance travelled in a
            specified direction from the starting point to the finishing point.
            It is a vector quantity.
        </p>
    </div>

    <div class="formula">
        <span class="name">Key idea</span>
        Distance = total path length
    </div>

    <div class="formula">
        <span class="name">Key idea</span>
        Displacement = straight-line change in position in a specified direction
    </div>

</section>


<!-- ===================================================== -->
<!-- 2. SPEED -->
<!-- ===================================================== -->

<section>

    <div class="eyebrow">02 · Speed</div>

    <h2>Speed</h2>

    <p class="lead">
        Speed tells us how quickly an object is moving.
    </p>

    <div class="formula">
        <span class="name">Average speed</span>
        average speed = total distance / total time taken
    </div>

    <table class="symbols">
        <tr>
            <th>Quantity</th>
            <th>Symbol</th>
            <th>SI unit</th>
        </tr>
        <tr>
            <td>distance</td>
            <td>s</td>
            <td>m</td>
        </tr>
        <tr>
            <td>time</td>
            <td>t</td>
            <td>s</td>
        </tr>
        <tr>
            <td>speed</td>
            <td>v</td>
            <td>m/s</td>
        </tr>
    </table>

    <h3>Uniform speed</h3>

    <p>
        A body moving with uniform speed covers equal distances
        in equal intervals of time.
    </p>

    <table class="uniform-table">
        <tr>
            <th>Time / s</th>
            <td>0</td>
            <td>10</td>
            <td>20</td>
            <td>30</td>
            <td>40</td>
        </tr>

        <tr>
            <th>Distance / m</th>
            <td>0</td>
            <td>25</td>
            <td>50</td>
            <td>75</td>
            <td>100</td>
        </tr>
    </table>

    <p style="font-size:14px;color:var(--ink-soft);">
        Every 10 s the body covers an additional 25 m.
        The distances covered in equal time intervals are equal.
    </p>


    <!-- Q1 -->

    <div class="qcard" data-answer="m/s">

        <div class="qlabel">Qu 1</div>

        <div class="qtext">
            Deduce the SI unit of speed.
        </div>

        <div class="qrow">

            <input type="text"
                   class="ans-text"
                   placeholder="unit">

            <button class="check">
                Check
            </button>

        </div>

        <div class="feedback"></div>

    </div>


    <!-- Q2 -->

    <div class="qcard"
         data-answer="8.33"
         data-tol="0.05">

        <div class="qlabel">Qu 2</div>

        <div class="qtext">
            In a 100 m race, the winner's time is 12.0 s.
            What is her average speed for this race?
        </div>

        <div class="formula">

            <span class="name">Reminder</span>

            average speed = total distance / total time taken

        </div>

        <div class="qrow">

            <input type="number"
                   class="ans-num"
                   step="0.01"
                   placeholder="0.00">

            <span class="u">m/s</span>

            <button class="check">
                Check
            </button>

        </div>

        <div class="feedback"></div>

    </div>

</section>


<!-- ===================================================== -->
<!-- 3. VELOCITY -->
<!-- ===================================================== -->

<section class="brake">

    <div class="eyebrow">03 · Velocity</div>

    <h2>Velocity</h2>

    <p class="lead">
        Velocity is speed in a specified direction.
        Unlike speed, velocity is a vector quantity.
    </p>

    <div class="formula">
        <span class="name">Key idea</span>
        velocity = displacement / time taken
    </div>

    <p>
        The SI unit of velocity is <b>m/s</b>.
    </p>

    <div class="qcard" data-answer="m/s">

        <div class="qlabel">Qu 3</div>

        <div class="qtext">
            What is the SI unit of velocity?
        </div>

        <div class="qrow">

            <input type="text"
                   class="ans-text"
                   placeholder="unit">

            <button class="check">
                Check
            </button>

        </div>

        <div class="feedback"></div>

    </div>

</section>


<!-- ===================================================== -->
<!-- 4. ACCELERATION -->
<!-- ===================================================== -->

<section class="brake">

    <div class="eyebrow">04 · Acceleration</div>

    <h2>Acceleration</h2>

    <p class="lead">
        Acceleration is the rate of change of velocity.
    </p>

    <div class="formula">

        <span class="name">
            Acceleration
        </span>

        acceleration =
        change in velocity / time taken

    </div>

    <table class="symbols">

        <tr>
            <th>Quantity</th>
            <th>Symbol</th>
            <th>SI unit</th>
        </tr>

        <tr>
            <td>initial velocity</td>
            <td>u</td>
            <td>m/s</td>
        </tr>

        <tr>
            <td>final velocity</td>
            <td>v</td>
            <td>m/s</td>
        </tr>

        <tr>
            <td>acceleration</td>
            <td>a</td>
            <td>m/s²</td>
        </tr>

        <tr>
            <td>time</td>
            <td>t</td>
            <td>s</td>
        </tr>

    </table>


    <!-- Q4 -->

    <div class="qcard"
         data-answer="0"
         data-tol="0.01">

        <div class="qlabel">Qu 4</div>

        <div class="qtext">
            What is the acceleration of a Mercedes car if it travels
            at a constant speed of 200 km/h for half an hour?
        </div>

        <div class="qrow">

            <input type="number"
                   class="ans-num"
                   step="0.01"
                   placeholder="0.00">

            <span class="u">m/s²</span>

            <button class="check">
                Check
            </button>

        </div>

        <div class="feedback"></div>

    </div>


    <!-- Q5 -->

    <div class="qcard"
         data-answer="3"
         data-tol="0.05">

        <div class="qlabel">Qu 5</div>

        <div class="qtext">
            A body accelerates for 25 s and its velocity increases
            from 250 to 325 m/s. Calculate its acceleration.
        </div>

        <div class="qrow">

            <input type="number"
                   class="ans-num"
                   step="0.01"
                   placeholder="0.00">

            <span class="u">m/s²</span>

            <button class="check">
                Check
            </button>

        </div>

        <div class="feedback"></div>

    </div>


    <!-- Q6 -->

    <div class="qcard"
         data-answer="37.5"
         data-tol="0.1">

        <div class="qlabel">Qu 6</div>

        <div class="qtext">
            A body starts from rest and accelerates uniformly at
            2.5 m/s² for 15 s. Deduce its final velocity.
        </div>

        <div class="qrow">

            <input type="number"
                   class="ans-num"
                   step="0.01"
                   placeholder="0.00">

            <span class="u">m/s</span>

            <button class="check">
                Check
            </button>

        </div>

        <div class="feedback"></div>

    </div>

</section>


<!-- ===================================================== -->
<!-- 5. DISTANCE-TIME GRAPHS -->
<!-- ===================================================== -->

<section>

    <div class="eyebrow">05 · Motion graphs</div>

    <h2>Distance–time graphs</h2>

    <p class="lead">
        A distance–time graph shows how the distance travelled
        by an object changes with time.
    </p>

    <div class="formula">
        <span class="name">Gradient</span>
        speed = gradient of a distance–time graph
    </div>

    <p>
        A steeper line represents a greater speed.
        A horizontal line represents an object that is stationary.
    </p>

    <div class="graphwrap">

        <svg viewBox="0 0 420 220"
             width="100%"
             style="max-width:420px;display:block;margin:auto;">

            <line class="axisline"
                  x1="50" y1="180"
                  x2="380" y2="180"></line>

            <line class="axisline"
                  x1="50" y1="20"
                  x2="50" y2="180"></line>

            <polyline
                points="50,180 130,140 210,100 290,60 370,20"
                fill="none"
                stroke="#E8541F"
                stroke-width="3"></polyline>

            <text class="axis-label"
                  x="215"
                  y="205"
                  text-anchor="middle">
                time / s
            </text>

            <text class="axis-label"
                  x="18"
                  y="100"
                  text-anchor="middle"
                  transform="rotate(-90 18 100)">
                distance / m
            </text>

        </svg>

    </div>

</section>


<!-- ===================================================== -->
<!-- 6. UNIFORM ACCELERATION -->
<!-- ===================================================== -->

<section class="brake">

    <div class="eyebrow">06 · Uniform acceleration</div>

    <h2>Velocity–time graphs</h2>

    <p>
        In uniform acceleration, velocity changes by equal amounts
        in equal intervals of time.
    </p>

    <table class="uniform-table">

        <tr>
            <th>Time / s</th>
            <td>0</td>
            <td>4</td>
            <td>8</td>
            <td>12</td>
            <td>16</td>
        </tr>

        <tr>
            <th>Velocity / m/s</th>
            <td>0</td>
            <td>10</td>
            <td>20</td>
            <td>30</td>
            <td>40</td>
        </tr>

    </table>

    <p style="font-size:14px;color:var(--ink-soft);">
        Every 4 s, the velocity increases by 10 m/s.
    </p>

    <div class="formula">

        <span class="name">
            Gradient
        </span>

        acceleration =
        change in velocity / time

    </div>

    <div class="formula">

        <span class="name">
            Area
        </span>

        distance travelled =
        area under a velocity–time graph

    </div>


    <!-- Q7 -->

