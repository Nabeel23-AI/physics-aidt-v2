<script>

/* =========================================================
   BASIC QUESTION CHECKING
========================================================= */

function checkText(id, answer, feedbackId) {

    const input =
        document.getElementById(id).value
        .trim()
        .toLowerCase()
        .replace(/\s+/g, '');

    const correct =
        answer.toLowerCase().replace(/\s+/g, '');

    const fb =
        document.getElementById(feedbackId);

    fb.className = "feedback show";

    if (input === correct) {

        fb.classList.add("correct");

        fb.innerHTML =
            "✓ Correct! Well done.";

    } else {

        fb.classList.add("wrong");

        fb.innerHTML =
            "✗ Not quite. Check your answer and try again.";

    }

}


function checkNumber(id, answer, tolerance, feedbackId) {

    const value =
        parseFloat(
            document.getElementById(id).value
        );

    const fb =
        document.getElementById(feedbackId);

    fb.className = "feedback show";

    if (
        !isNaN(value) &&
        Math.abs(value - answer) <= tolerance
    ) {

        fb.classList.add("correct");

        fb.innerHTML =
            "✓ Correct! Well done.";

    } else {

        fb.classList.add("wrong");

        fb.innerHTML =
            "✗ Not quite. Check your working and try again.";

    }

}


/* =========================================================
