/* =========================================================
   REVEAL BUTTONS
========================================================= */

function toggle(id) {

    const element =
        document.getElementById(id);

    element.classList.toggle("show");

}


/* =========================================================
   DISTANCE-TIME GRAPHS
========================================================= */

function showDT(type) {

    const path =
        document.getElementById("dtPath");

    const desc =
        document.getElementById("dtDesc");

    if (type === "uniform") {

        path.setAttribute(
            "d",
            "M30 140 L270 30"
        );

        desc.innerHTML =
            "A straight sloping line represents uniform speed.";

    }

    if (type === "rest") {

        path.setAttribute(
            "d",
            "M30 80 L270 80"
        );

        desc.innerHTML =
            "A horizontal line means the object is stationary.";

    }

    if (type === "fast") {

        path.setAttribute(
            "d",
            "M30 140 C120 140 150 110 270 30"
        );

        desc.innerHTML =
            "An increasing gradient means the object is speeding up.";

    }

    if (type === "slow") {

        path.setAttribute(
            "d",
            "M30 140 C120 70 200 45 270 35"
        );

        desc.innerHTML =
            "A decreasing gradient means the object is slowing down.";

    }

}


/* =========================================================
   VELOCITY-TIME GRAPHS
========================================================= */

function showVT(type) {

    const path =
        document.getElementById("vtPath");

    const desc =
        document.getElementById("vtDesc");

    if (type === "accel") {

        path.setAttribute(
            "d",
            "M30 140 L270 30"
        );

        desc.innerHTML =
            "An upward straight line represents uniform acceleration.";

    }

    if (type === "constant") {

        path.setAttribute(
            "d",
            "M30 70 L270 70"
        );

        desc.innerHTML =
            "A horizontal line means constant velocity.";

    }

    if (type === "decel") {

        path.setAttribute(
            "d",
            "M30 30 L270 140"
        );

        desc.innerHTML =
            "A downward straight line represents uniform deceleration.";

    }

    if (type === "rest") {

        path.setAttribute(
            "d",
            "M30 140 L270 140"
        );

        desc.innerHTML =
            "A line along the time axis means the object is at rest.";

    }

}


/* =========================================================
   COIN AND FEATHER
========================================================= */

function dropObjects(vacuum) {

    const coin =
        document.getElementById("coin");

    const feather =
        document.getElementById("feather");

    if (vacuum) {

        coin.style.top = "190px";

        setTimeout(function() {

            feather.style.top = "190px";

        }, 100);

    } else {

        coin.style.top = "190px";

        setTimeout(function() {

            feather.style.top = "80px";

        }, 800);

    }

}


function resetObjects() {

    document.getElementById("coin").style.top =
        "12px";

    document.getElementById("feather").style.top =
        "12px";

}

