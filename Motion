            "100px";

        note.textContent =
            "With air present, the feather experiences a much greater effect from air resistance and falls more slowly than the coin.";

    }
);


document.getElementById(
    "drop-vacuum"
).addEventListener(
    "click",
    () => {

        coin.style.top =
            "190px";

        feather.style.top =
            "190px";

        note.textContent =
            "In a vacuum, there is no air resistance. The coin and feather have the same acceleration due to gravity and reach the bottom together.";

    }
);


document.getElementById(
    "reset-tube"
).addEventListener(
    "click",
    () => {

        coin.style.top =
            "12px";

        feather.style.top =
            "12px";

        note.textContent =
            "With air present, the feather experiences a much greater effect from air resistance and falls more slowly.";

    }
);


/* =====================================================
   Q12 REVEAL
===================================================== */

document.getElementById(
